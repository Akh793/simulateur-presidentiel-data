{
  "expo": {
    "name": "Simulateur Présidentiel",
    "slug": "simulateur-presidentiel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.simpres.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B192C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.simpres.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite"
    ],
    "scheme": "simpres",
    "backgroundColor": "#0B192C",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B192C"
    },
    "extra": {
      "graine": {
        "urls": [
          "https://raw.githubusercontent.com/Akh793/simulateur-presidentiel-data/data/public/graine_du_jour.json",
          "https://OWNER.github.io/REPO/graine_du_jour.json"
        ],
        "delaiMs": 8000
      }
    }
  }
}
